# Google Gemini API key — used to study the resume and answer questions.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generation model — Gemini answers questions fluently from the resume
GEMINI_MODEL=gemini-2.5-flash

# Retrieval threshold (TF-IDF + keyword boost)
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_TOP_K=5
MAX_OUTPUT_TOKENS=1024

# Set to 1 only for offline demo without Gemini
FORCE_LOCAL_SYNTH=0
